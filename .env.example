# Copy this file to ".env" (same folder as package.json) and fill in real
# values — "cp .env.example .env". The real .env file is never committed to
# git (see .gitignore); this .example file is, so anyone setting the project
# up sees exactly which variables exist and what they're for, without ever
# seeing a real secret.
#
# Once .env exists, `node server.js` picks it up automatically — no need to
# type these in front of the command anymore. A real environment variable
# (e.g. one you `export`ed, or passed inline like `GEMINI_API_KEY=xxx node
# server.js`) always overrides the value here, so this is just a fallback/
# default, never a hard override. See server/dotenv-lite.js for exactly how
# this is loaded.
#
# This file is only for LOCAL development. On Vercel, set these same names
# in the Vercel dashboard instead (Project Settings -> Environment
# Variables) — those are used in production regardless of what's in here,
# and .env doesn't exist there at all. See the Go-Live Guide in README.md.

# --- Required for the app's real (non-local-mock) data to work at all ---
# Supabase project URL and service role key (Project Settings -> API in the
# Supabase dashboard). NEVER use the public "anon" key here — this app
# always connects with the service role key and enforces permissions in its
# own server code (see README's "Row Level Security is intentionally left
# off" section).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: only needed for the AI smart-fill / AI Assistant / 上傳核准
# --- 通知信 features ---
# A Gemini API key (aistudio.google.com/apikey). Leave blank and everything
# else in the app still works fine — those AI-powered features just show a
# friendly "not configured" message instead of erroring.
GEMINI_API_KEY=

# Optional — which Gemini model to call. Leave blank to use this app's
# built-in default (see server/ai.js / server/assistant.js).
GEMINI_MODEL=

# --- Optional ---
# Which local port `node server.js` listens on. Defaults to 3000.
PORT=
